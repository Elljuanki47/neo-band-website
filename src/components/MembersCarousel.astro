---
import { bandConfig } from "../config/band.config";

const members = bandConfig.about.members.map((member) => ({
    ...member,
    fullName: [
        member.name,
        member.nickname ? `"${member.nickname}"` : "",
        member.surname,
    ]
        .filter(Boolean)
        .join(" "),
}));

const carouselMembers = [
    members[members.length - 1],
    ...members,
    members[0],
];

---

<div class="mt-20 border-t border-white/15 pt-16" data-members-carousel>
    <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
        Integrantes
    </p>
    
    <div 
        class="mt-8 overflow-hidden touch-pan-y"
        data-carousel-viewport
    >
        <div
            class="member-track flex transition-transform duration-500 ease-out motion-reduce:transition-none"
            style="transform: translateX(-100%);"
        >
            {
                carouselMembers.map((member) => (
                    <article class="member-slide w-full shrink-0 grid gap-10 md:grid-cols-2 md:items-center">
                        <div class="flex aspect-4/5 items-center justify-center border border-white/15 bg-white/5">
                            <p class="text-center text-sm uppercase tracking-[0.25em] text-brand-white/50">
                                Foto próximamente
                            </p>
                        </div>

                        <div>
                            <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
                                {member.role}
                            </p>

                            <h3 class="mt-3 font-display text-4xl tracking-widest sm:text-6xl">
                                {member.fullName}
                            </h3>

                            <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-white/75">
                                {member.bio}
                            </p>

                            <a 
                                href={member.instagram}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-8 inline-flex border border-white px-5 py-3 text-sm uppercase tracking-[0.15em] text-brand-white transition-colors duration-300 hover:bg-brand-white hover:text-brand-black focus-visible:bg-brand-white focus-visible:text-brand-black focus-visible:outline-none"
                            >
                                Instagram personal ↗
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>

    <div class="mt-10 flex items-center justify-between">
        <button
            type="button"
            data-carousel-previous
            aria-label="Ver integrante anterior"
            class="border border-white px-4 py-2 text-xl text-brand-white transition-colors hover:bg-brand-white hover:text-brand-black focus-visible:bg-brand-white focus-visible:text-brand-black focus-visible:outline-none"
        >
            ←
        </button>

        <p
            data-carousel-indicator
            class="text-sm uppercase tracking-[0.2em] text-brand-white/60"
        >
            1 / {members.length}
        </p>

        <button
            type="button"
            data-carousel-next
            aria-label="Ver integrante siguiente"
            class="border border-white px-4 py-2 text-xl text-brand-white transition-colors hover:bg-brand-white hover:text-brand-black focus-visible:bg-brand-white focus-visible:text-brand-black focus-visible:outline-none"
        >
            →
        </button>
    </div>

</div>

<script>
    const carousel = document.querySelector<HTMLElement>(
        "[data-members-carousel]"
    );

    if (carousel) {
        const track = carousel.querySelector<HTMLElement>(".member-track");
        const slides = carousel.querySelectorAll<HTMLElement>(".member-slide");
        const viewport = carousel.querySelector<HTMLElement>(
            "[data-carousel-viewport]"
        );

        const previousButton = carousel.querySelector<HTMLButtonElement>(
            "[data-carousel-previous]"
        );

        const nextButton = carousel.querySelector<HTMLButtonElement>(
            "[data-carousel-next]"
        );

        const indicator = carousel.querySelector<HTMLElement>(
            "[data-carousel-indicator]"
        );

        const memberCount = slides.length - 2;
        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)"
        ).matches;

        let currentSlide = 1;
        let isTransitioning = false;

        function updateIndicator() {
            const currentMember = 
                (currentSlide - 1 + memberCount) % memberCount;

            if (indicator) {
                indicator.textContent = `${currentMember + 1} / ${memberCount}`;
            }
        }

        function updateTrackPosition() {
            track?.style.setProperty(
                "transform",
                `translateX(-${currentSlide * 100}%)`
            );
        }

        function jumpToSlide(index: number) {
            if (!track) return;

            track.classList.remove(
                "transition-transform",
                "duration-500",
                "ease-out"
            );

            currentSlide = index;
            updateTrackPosition();
            updateIndicator();

            void track.offsetWidth;

            track.classList.add(
                "transition-transform",
                "duration-500",
                "ease-out"
            );
        }

        function moveToSlide(index: number) {
            if (isTransitioning) return;

            currentSlide = index;

            if (prefersReducedMotion) {
                if (currentSlide === 0) {
                    currentSlide = memberCount;
                }

                if (currentSlide === memberCount + 1) {
                    currentSlide = 1;
                }

                updateTrackPosition();
                updateIndicator();
                return;
            }

            isTransitioning = true;
            updateTrackPosition();
            updateIndicator();
        }

        track?.addEventListener("transitionend", (event) => {
            if (event.propertyName !== "transform") return;

            if (currentSlide === 0) {
                jumpToSlide(memberCount);
            }

            if (currentSlide === memberCount + 1) {
                jumpToSlide(1);
            }

            isTransitioning = false;
        });

        previousButton?.addEventListener("click", () => {
            moveToSlide(currentSlide - 1);
        });

        nextButton?.addEventListener("click", () => {
            moveToSlide(currentSlide + 1);
        });

        let touchStartX = 0;
        let touchStartY = 0;

        const SWIPE_THRESHOLD = 50;

        viewport?.addEventListener("touchstart", (event) => {
            const touch = event.changedTouches[0];

            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
        });

        viewport?.addEventListener("touchend", (event) => {
            const touch = event.changedTouches[0];

            const horizontalDistance = touchStartX - touch.clientX;
            const verticalDistance = touchStartY - touch.clientY;

            const isHorizontalSwipe =
                Math.abs(horizontalDistance) > Math.abs(verticalDistance);
            
            const passedThreshold =
                Math.abs(horizontalDistance) >= SWIPE_THRESHOLD;

            if (!isHorizontalSwipe || !passedThreshold) return;

            if (horizontalDistance > 0) {
                moveToSlide(currentSlide + 1);
            } else {
                moveToSlide(currentSlide - 1);
            }
        });
    }
</script>