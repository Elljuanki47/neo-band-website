---
import { bandConfig } from '../config/band.config';
---



<section
    class="min-h-screen bg-brand-black text-brand-white flex flex-col items-center justify-center text-center px-6"
>
    <img 
        src={bandConfig.logo}
        alt={`logo de ${bandConfig.name}`}
        class="w-52 h-52 rounded-full object-cover mb-8"
    />  

    <h1 class="text-9xl font-bold tracking-widest font-display">
        {bandConfig.name}
    </h1>

    <p class="mt-3 text-sm uppercase tracking-[0.2em] text-gray-500">
        {bandConfig.tagline}
    </p>

    <a 
        href={bandConfig.latestRelease.spotifyUrl}
        target="_blank"
        class="mt-8 bg-red600 hover:bg-red-700 px-8 py-3 rounded-full font-bold transition"
    >
        ▶ AMULETO
    </a>

</section>
