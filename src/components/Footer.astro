---
import { bandConfig } from "../config/band.config";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/15 bg-brand-black px-6 py-8 text-brand-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 text-center text-sm">
        <div>
            <p class="font-display text-xl tracking-widest">{bandConfig.name}</p>
            <p class="mt-1 text-brand-white/60">{bandConfig.tagline}</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-brand-white/70">
            <a
            href={`mailto:${bandConfig.social.bookingEmail}`}
            class="transition hover:text-brand-red"
            >
                Contrataciones
            </a>

        </div>
    
        <p class="text-brand-white/50">
            © {currentYear} {bandConfig.name}
        </p>
    </div>
</footer>