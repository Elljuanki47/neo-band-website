---
import { bandConfig } from "../config/band.config";
import MembersCarousel from "./MembersCarousel.astro";
---

<section id="banda" class="bg-brand-black px-6 py-24 text-brand-white">
    <div class="mx-auto max-w-5xl">
        <div class="flex aspect-16/7 items-center justify-center border border-white/15 bg-white/5">
            <p class="text-center text-sm uppercase tracking-[0.25em] text-brand-white/50">
                Foto oficial proximamente
            </p>
        </div>

        <div class="mt-12 max-w-3xl">
            <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
                La banda
            </p>

            <h2 class="mt-3 font-display text-5xl tracking-widest sm:text-6xl md:text-7xl">
               QUIÉNES SOMOS 
            </h2>

            <p class="mt-6 text-lg leading-relaxed text-brand-white/75">
                {bandConfig.about.description}
            </p>
        </div>

        <MembersCarousel />
    </div>
</section>
