---
import { bandConfig } from "../config/band.config";
import { Icon } from "astro-icon/components";

const socialLinks = [
    {
        label: "Instagram",
        href: bandConfig.social.instagram,
        icon: "simple-icons:instagram",
    },
    {
        label: "Spotify",
        href: bandConfig.social.spotify,
        icon: "simple-icons:spotify",
    },
    {
        label: "YouTube",
        href: bandConfig.social.youtube,
        icon: "simple-icons:youtube",
    },
    {
        label: "TikTok",
        href: bandConfig.social.tiktok,
        icon: "simple-icons:tiktok",
    },
];
---

<section id="redes" class="bg-brand-black px-6 py-24 text-brand-white">
    <div class="mx-auto max-w-6xl">
        <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
            SEGUINOS
        </p>

        <h2 class="mt-3 font-display text-5xl tracking-widest sm:text-6xl md:text-7xl">
            NEO EN TODAS PARTES
        </h2>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-white/75">
            Música, novedades y próximos anuncios en nuestras redes.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {
                socialLinks.map((link) => (
                    <a 
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Abrir ${link.label} de NEO`}
                        class="flex items-center justify-between border border-white/15 px-5 py-4 text-sm uppercase tracking-[0.15em] text-brand-white transition-colors duration-300 hover:border-brand-white hover:bg-brand-white hover:text-brand-red focus-visible:border-brand-white focus-visible:bg-brand-white focus-visible:text-brand-red focus-visible:outline-none"
                        >
                            <span>{link.label}</span>

                            <Icon
                                name={link.icon}
                                aria-hidden="true"
                                class="h-5 w-5"
                            />
                    </a>
                ))
            }
        </div>
    </div>
</section>
