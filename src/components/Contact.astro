---
import { bandConfig } from "../config/band.config";
---

<section id="contacto" class="bg-brand-black px-6 py-24 text-brand-white">
    <div class="mx-auto max-w-6xl border-t border-white/15 pt-16">
        <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
            Contacto
        </p>

        <h2 class="mt-3 font-display text-5xl trackiong-widest sm:text-6xl md:text-7xl">
            CONTRATACIONES
        </h2>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-white/75">
            Para fechas, contrataciones y consultas, escribinos a:
        </p>

        <a 
            href={`mailto${bandConfig.social.bookingEmail}`}
            class="mt-8 inline-block text-xl text-brand-white transition hover:text-brand-red sm:text-2xl"
        >
            {bandConfig.social.bookingEmail}
        </a>
    </div>
</section>