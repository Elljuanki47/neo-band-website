---
import { bandConfig } from "../config/band.config";
---

<section id="musica" class="bg-brand-black text-brand-white py-32 px-6">

    <div class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-12 md:flex-row">

        <img 
            src={bandConfig.latestRelease.cover}
            alt={`Portada de ${bandConfig.latestRelease.title}`}
            class="w-full max-w-80 aspect-square object-cover rounded-lg shadow-2xl border border-white/10"
        />

        <div class="flex flex-col justify-center items-center md:items-start text-center md:text-left">

            <p class="text-sm uppercase tracking-[0.3em] text-gray-400">
                Último lanzamiento
            </p>

            <h2 class="mt-2 text-5xl sm:text-6xl md:text-8xl font-display tracking-widest">
                {bandConfig.latestRelease.title}
            </h2>


            <iframe
                src={bandConfig.latestRelease.spotifyEmbed}
                title ={`Reproductor de Spotify - ${bandConfig.latestRelease.title}`}
                width="100%"
                height="152"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                class="mt-5 w-full max-w-80 rounded-xl transition hover:scale-[1.02]"
            />

            <a 
                href={bandConfig.latestRelease.spotifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center border border-white px-5 py-3 text-sm uppercase tracking-[0.15em] text-brand-white transition-colors duration-300 hover:bg-brand-white hover:text-brand-black focus-visible:bg-brand-white focus-visible:text-brand-black focus-visible:outline-none"
            >
                Escuchar en Spotify
            </a>
        </div>

    </div>
</section>